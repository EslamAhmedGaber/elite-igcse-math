\definecolor{brandnavy}{HTML}{161B2E}
\definecolor{brandnavydark}{HTML}{0E1220}
\definecolor{brandred}{HTML}{C0392B}
\definecolor{brandreddeep}{HTML}{8D2820}
\definecolor{brandgreen}{HTML}{5A8074}
\definecolor{brandochre}{HTML}{C08A3E}
\definecolor{brandgold}{HTML}{C08A3E}
\definecolor{brandgoldlight}{HTML}{DCB877}
\definecolor{brandcream}{HTML}{FBF6E6}
\definecolor{brandvellum}{HTML}{EBDFC4}
\definecolor{brandline}{HTML}{CFC9BE}
\definecolor{rulegrey}{HTML}{CFC9BE}
\definecolor{textgrey}{HTML}{5A5258}
\colorlet{brandquestion}{brandnavy}
\colorlet{brandquestiondark}{brandnavydark}
\colorlet{brandanswer}{brandnavydark}
\colorlet{brandaccent}{brandochre}
\colorlet{brandaccentsoft}{brandgoldlight}

\newcommand{\elitepagewatermark}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[
      scale=8.8,
      text=brandquestion!4,
      font=\rmfamily
    ] at (current page.center) {EA};
  \end{tikzpicture}%
}
\AddToHook{shipout/background}{\elitepagewatermark}

\newcommand{\pillbadge}[2]{%
  \tikz[baseline=(b.base)]{
    \node[
      fill=brandaccent,
      rounded corners=2pt,
      inner xsep=6pt, inner ysep=2.5pt,
      font=\sffamily\bfseries\footnotesize,
      text=brandanswer
    ] (b) {#1\,\textcolor{brandanswer}{\footnotesize\textbf{#2}}};
  }%
}

\newcommand{\classifiedquestionheader}[7]{%
  \clearpage\noindent
  \begin{tcolorbox}[
    enhanced,
    colback=brandquestion, colframe=brandquestion,
    boxrule=0pt, arc=0pt,
    left=12pt, right=12pt, top=8pt, bottom=8pt,
    borderline south={2pt}{0pt}{brandaccent},
  ]
    {\sffamily\bfseries\color{white}\large CLASSIFIED PROBLEM}\hfill
    \pillbadge{Paper:}{\,#1}\,\pillbadge{Session:}{\,#2}\,\pillbadge{Q\#:}{\,#3}\,\pillbadge{Marks:}{\,#4}\\[3pt]
    {\sffamily\color{brandaccentsoft}\small\textsc{Topic:} \textbf{#5}}\\[2pt]
    {\sffamily\color{white!84}\footnotesize Source: #7}
  \end{tcolorbox}
  \par\vspace{6pt}
}

\newcommand{\problemimagepage}[1]{%
  \begin{center}
    \begin{tcolorbox}[
      enhanced,
      colback=white,
      colframe=brandline,
      arc=1pt,
      boxrule=0.5pt,
      left=8pt,right=8pt,top=8pt,bottom=8pt,
      borderline west={2pt}{0pt}{brandaccent},
    ]
      \centering\includegraphics[width=\linewidth,height=0.70\textheight,keepaspectratio]{#1}
    \end{tcolorbox}
  \end{center}
}

\newcommand{\solutionheader}{%
  \noindent
  \begin{tcolorbox}[
    enhanced,
    colback=brandanswer, colframe=brandanswer,
    boxrule=0pt, arc=0pt,
    left=12pt, right=12pt, top=8pt, bottom=8pt,
    borderline south={2pt}{0pt}{brandaccent},
  ]
    {\sffamily\bfseries\color{white}\large WORKED SOLUTION}\hfill
    {\sffamily\footnotesize\color{brandaccentsoft}\itshape Dr.~Eslam Ahmed}
  \end{tcolorbox}
}

