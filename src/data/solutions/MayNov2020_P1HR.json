      "updated": "2026-05-06T07:57:33",
      "topicNote": "Functions. The tag is correct.",
      "steps": [
        {
          "title": "Evaluate fraction",
          "body": "\\[\nf(x)=5x-7,\\qquad g(x)=\\frac{5x}{x+4}\n\\]"
        },
        {
          "title": "(a) The denominator of cannot",
          "body": "(a) The denominator of \\(g\\) cannot be zero, so\n\\[\nx=-4\n\\]"
        },
        {
          "title": "(b)",
          "body": "(b)\n\\[\nf(2.6)=5(2.6)-7=6\n\\]\n\n\\[\ngf(2.6)=g(6)=\\frac{5(6)}{6+4}=3\n\\]"
        },
        {
          "title": "(c)",
          "body": "(c)\n\\[\nfg(x)=2\n\\]\n\n\\[\nf(g(x))=2\n\\]\n\n\\[\n5g(x)-7=2\n\\]\n\n\\[\ng(x)=\\frac95\n\\]\n\n\\[\n\\frac{5x}{x+4}=\\frac95\n\\]\n\n\\[\n25x=9x+36\n\\]\n\n\\[\n16x=36\n\\]\n\n\\[\nx=\\frac94\n\\]"
        },
        {
          "title": "(d) Let",
          "body": "(d) Let\n\\[\ny=\\frac{5x}{x+4}\n\\]\n\n\\[\ny(x+4)=5x\n\\]\n\n\\[\nyx+4y=5x\n\\]\n\n\\[\nx(y-5)=-4y\n\\]\n\n\\[\nx=\\frac{4y}{5-y}\n\\]"
        },
        {
          "title": "Evaluate fraction",
          "body": "So\n\\[\ng^{-1}(x)=\\frac{4x}{5-x}\n\\]"
        }
      ],
      "finalAnswer": "\\(-4\\), \\(3\\), \\(x=\\frac94\\), and \\(g^{-1}(x)=\\dfrac{4x}{5-x}\\)."
    },
