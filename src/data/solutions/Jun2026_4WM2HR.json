      "steps": [
        {
          "title": "fg(x): put g into f",
          "body": "\\[\\mathrm{fg}(x)=(2x+1)^2-5=4x^2+4x-4\\]"
        },
        {
          "title": "gf(x): put f into g",
          "body": "\\[\\mathrm{gf}(x)=2(x^2-5)+1=2x^2-9,\\qquad 2\\,\\mathrm{gf}(x)=4x^2-18\\]"
        },
        {
          "title": "Solve",
          "body": "\\[4x^2+4x-4=4x^2-18\\Rightarrow4x=-14\\Rightarrow x=-3.5\\]"
        }
