      "updated": "2026-05-06T07:04:07",
      "topicNote": "Correct.",
      "steps": [
        {
          "title": "The line is",
          "body": "The line is\n\n\\[\nx+y=5\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So\n\n\\[\ny=5-x\n\\]"
        },
        {
          "title": "Substitute into the curve",
          "body": "Substitute into the curve:\n\n\\[\n2x^2+3y^2=210\n\\]\n\n\\[\n2x^2+3(5-x)^2=210\n\\]\n\n\\[\n2x^2+3(x^2-10x+25)=210\n\\]\n\n\\[\n5x^2-30x+75=210\n\\]\n\n\\[\n5x^2-30x-135=0\n\\]"
        },
        {
          "title": "Divide by 5",
          "body": "Divide by 5:\n\n\\[\nx^2-6x-27=0\n\\]"
        },
        {
          "title": "Factorise",
          "body": "Factorise:\n\n\\[\n(x-9)(x+3)=0\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So\n\n\\[\nx=9 \\quad \\text{or} \\quad x=-3\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "Using \\(y=5-x\\):\n\n\\[\nx=9 \\Rightarrow y=-4\n\\]\n\n\\[\nx=-3 \\Rightarrow y=8\n\\]"
        }
      ],
      "finalAnswer": "\\((9,-4)\\) and \\((-3,8)\\)"
    },
