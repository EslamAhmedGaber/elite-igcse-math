    "all::Jun2024_P2H__Q14__p14-14__m07__Algebraic-Proof": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:35:26",
      "topicNote": "Algebraic proof. The tag is correct.",
      "steps": [
        {
          "title": "(a)",
          "body": "(a)\n\\[\n3y(2y+5)(y+7)\n\\]"
        },
        {
          "title": "Expand brackets",
          "body": "First expand the two brackets:\n\\[\n(2y+5)(y+7)=2y^2+14y+5y+35=2y^2+19y+35\n\\]"
        },
        {
          "title": "Multiply by",
          "body": "Now multiply by \\(3y\\):\n\\[\n3y(2y^2+19y+35)=6y^3+57y^2+105y\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So \\(a=6\\), \\(b=57\\), and \\(c=105\\)."
        },
        {
          "title": "(b)",
          "body": "(b)\n\\[\n\\frac{2x+3}{5}+\\frac{6x-5}{4}=\\frac{163}{100}\n\\]"
        },
        {
          "title": "Multiply by 100",
          "body": "Multiply by 100:\n\\[\n20(2x+3)+25(6x-5)=163\n\\]\n\n\\[\n40x+60+150x-125=163\n\\]\n\n\\[\n190x-65=163\n\\]\n\n\\[\n190x=228\n\\]\n\n\\[\nx=\\frac{228}{190}=\\frac65\n\\]"
        }
      ],
      "finalAnswer": "\\(6y^3+57y^2+105y\\), and \\(x=\\frac65\\)."
    },
    "all::Jun2024_P2H__Q10__p10-10__m03__Simultaneous-Equations": {
      "status": "checked",
