        {
          "title": "Complete the square",
          "body": "Complete the square:\n\n\\[\nf(x)=2(x^2-12x)+7\n\\]\n\n\\[\nf(x)=2[(x-6)^2-36]+7\n\\]\n\n\\[\nf(x)=2(x-6)^2-65\n\\]"
        },
        {
          "title": "Let",
          "body": "Let \\(y=f(x)\\).\n\n\\[\ny=2(x-6)^2-65\n\\]\n\n\\[\ny+65=2(x-6)^2\n\\]\n\n\\[\n\\frac{y+65}{2}=(x-6)^2\n\\]"
        },
        {
          "title": "Simplify surd",
          "body": "Since \\(x\\ge 6\\), take the positive square root:\n\n\\[\nx-6=\\sqrt{\\frac{y+65}{2}}\n\\]\n\n\\[\nx=6+\\sqrt{\\frac{y+65}{2}}\n\\]"
        },
        {
          "title": "Replace by",
          "body": "Replace \\(y\\) by \\(x\\)."
        }
      ],
      "finalAnswer": "\\(\\displaystyle f^{-1}(x)=6+\\sqrt{\\frac{x+65}{2}}\\)"
