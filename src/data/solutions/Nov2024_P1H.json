        {
          "title": "Differentiate",
          "body": "Differentiate:\n\n\\[\n\\frac{dy}{dx}=8x^3-64\n\\]"
        },
        {
          "title": "Find the gradient",
          "body": "At the minimum point, the gradient is 0.\n\n\\[\n8x^3-64=0\n\\]\n\n\\[\n8x^3=64\n\\]\n\n\\[\nx^3=8\n\\]\n\n\\[\nx=2\n\\]"
        },
        {
          "title": "Find the coordinate",
          "body": "Find the \\(y\\)-coordinate:\n\n\\[\ny=2(2)^4-64(2)\n\\]\n\n\\[\ny=32-128=-96\n\\]"
        },
        {
          "title": "The tangent at a minimum",
          "body": "The tangent at a minimum point is horizontal, so its equation is\n\n\\[\ny=-96\n\\]"
        }
      ],
