    "all::Jun2024_P2HR__Q26__p30-30__m04__Algebraic-Fractions": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:04:07",
      "topicNote": "Corrected from Sine/Cosine Rule to Algebraic Fractions.",
      "steps": [
        {
          "title": "Use trigonometry",
          "body": "\\[\n4-\\left[(3x-5)\\div\\frac{3x^2+x-10}{4x-1}\\right]\n\\]"
        },
        {
          "title": "Factor the quadratic",
          "body": "Factor the quadratic:\n\n\\[\n3x^2+x-10=(3x-5)(x+2)\n\\]"
        },
        {
          "title": "Use trigonometry",
          "body": "So the expression inside the square brackets is\n\n\\[\n(3x-5)\\div\\frac{(3x-5)(x+2)}{4x-1}\n\\]"
        },
        {
          "title": "Dividing by a fraction means",
          "body": "Dividing by a fraction means multiplying by its reciprocal:\n\n\\[\n(3x-5)\\times \\frac{4x-1}{(3x-5)(x+2)}\n\\]"
        },
        {
          "title": "Cancel",
          "body": "Cancel \\(3x-5\\):\n\n\\[\n\\frac{4x-1}{x+2}\n\\]"
        },
        {
          "title": "Use trigonometry",
          "body": "Therefore the full expression is\n\n\\[\n4-\\frac{4x-1}{x+2}\n\\]"
        },
        {
          "title": "Use the common denominator",
          "body": "Use the common denominator \\(x+2\\):\n\n\\[\n\\frac{4(x+2)-(4x-1)}{x+2}\n\\]\n\n\\[\n=\\frac{4x+8-4x+1}{x+2}\n\\]\n\n\\[\n=\\frac9{x+2}\n\\]"
        }
      ],
      "finalAnswer": "\\(\\displaystyle \\boxed{\\frac9{x+2}}\\)"
    },
