    "all::May2024_P1HR__Q21__p21-21__m05__Probability-Toolkit": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:04:07",
      "topicNote": "Correct.",
      "steps": [
        {
          "title": "There are 25 counters",
          "body": "There are 25 counters."
        },
        {
          "title": "Blue counters",
          "body": "Blue counters:\n\n\\[\n6\n\\]"
        },
        {
          "title": "Orange counters",
          "body": "Orange counters:\n\n\\[\nx\n\\]"
        },
        {
          "title": "Pink counters",
          "body": "Pink counters:\n\n\\[\n25-6-x=19-x\n\\]"
        },
        {
          "title": "The probability of taking one",
          "body": "The probability of taking one orange and one pink in either order is\n\n\\[\n\\frac{x}{25}\\cdot\\frac{19-x}{24}\n+\\frac{19-x}{25}\\cdot\\frac{x}{24}\n\\]\n\n\\[\n=\\frac{2x(19-x)}{25\\cdot24}\n\\]"
        },
        {
          "title": "Evaluate fraction",
          "body": "This is equal to \\(\\frac{22}{75}\\), so\n\n\\[\n\\frac{2x(19-x)}{600}=\\frac{22}{75}\n\\]\n\n\\[\n\\frac{x(19-x)}{300}=\\frac{22}{75}\n\\]\n\n\\[\nx(19-x)=88\n\\]\n\n\\[\n19x-x^2=88\n\\]\n\n\\[\nx^2-19x+88=0\n\\]\n\n\\[\n(x-8)(x-11)=0\n\\]"
        },
        {
          "title": "Solve inequality",
          "body": "Since \\(x>9\\),\n\n\\[\nx=11\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So the number of pink counters is\n\n\\[\n19-11=8\n\\]"
        },
        {
          "title": "The probability of taking 2",
          "body": "The probability of taking 2 pink counters is\n\n\\[\n\\frac{8}{25}\\cdot\\frac{7}{24}=\\frac{56}{600}\n\\]\n\n\\[\n=\\frac{7}{75}\n\\]"
        }
      ],
      "finalAnswer": "\\(\\frac{7}{75}\\)"
    },
    "expertise::May2024_P1HR__Q20__p20-20__m05__Completing-the-Square": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-05",
      "topicNote": "Moved from Coordinate Geometry to Completing the Square.",
      "steps": [
        {
          "title": "Use Moved Coordinate Geometry Completing",
          "body": "For part (a),\n\n\\[\n2x^2-11x+9\n\\]"
        },
