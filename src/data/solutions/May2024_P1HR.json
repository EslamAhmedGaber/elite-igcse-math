        {
          "title": "Use trigonometry",
          "body": "Since\n\n\\[\nAD=12,\\qquad DE=20,\\qquad AB=8\n\\]"
        },
        {
          "title": "take",
          "body": "take\n\n\\[\nB=(0,0,8)\n\\]"
