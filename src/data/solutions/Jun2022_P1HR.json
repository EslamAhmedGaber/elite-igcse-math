          "title": "Simplify surd",
          "body": "So\n\n\\[\n\\frac{3+2\\sqrt{2}}{3-2\\sqrt{2}}\n\\]"
        },
        {
          "title": "Rationalise the denominator",
          "body": "Rationalise the denominator:\n\n\\[\n\\frac{3+2\\sqrt{2}}{3-2\\sqrt{2}}\\times \\frac{3+2\\sqrt{2}}{3+2\\sqrt{2}}\n=\\frac{(3+2\\sqrt{2})^2}{9-8}\n\\]\n\n\\[\n(3+2\\sqrt{2})^2=9+12\\sqrt{2}+8=17+12\\sqrt{2}\n\\]"
        }
      ],
      "finalAnswer": "\\(17+12\\sqrt{2}\\)"
    },
    "expertise::Jun2022_P1HR__Q23__p26-26__m05__Completing-the-Square": {
