    "all::Jun2022_P1HR__Q18__p20-20__m04__3D-Pythagoras-and-Trigonometry": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:57:33",
      "topicNote": "Corrected to 3D Pythagoras and trigonometry. The question asks for a 3D distance through a cube.",
      "steps": [
        {
          "title": "The cube has side length",
          "body": "The cube has side length \\(6\\) cm."
        },
        {
          "title": "Find the midpoint",
          "body": "Let \\(T\\) be the midpoint of \\(AB\\) and \\(V\\) be the midpoint of \\(CH\\)."
        },
        {
          "title": "The changes in the three",
          "body": "The changes in the three perpendicular directions from \\(T\\) to \\(V\\) are\n\\[\n3,\\quad 3,\\quad 6\n\\]"
        },
        {
          "title": "Use trigonometry",
          "body": "So by 3D Pythagoras,\n\\[\nTV=\\sqrt{3^2+3^2+6^2}\n\\]\n\n\\[\nTV=\\sqrt{9+9+36}=\\sqrt{54}\n\\]"
        }
      ],
      "finalAnswer": "\\(\\sqrt{54}\\text{ cm}\\)."
    },
