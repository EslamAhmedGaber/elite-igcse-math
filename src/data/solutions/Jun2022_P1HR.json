    "all::Jun2022_P1HR__Q23__p26-26__m05__Completing-the-Square": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:04:07",
      "topicNote": "Correct.",
      "steps": [
        {
          "title": "(a)",
          "body": "(a)\n\n\\[\n2x^2-12x+3=2(x^2-6x)+3\n\\]\n\n\\[\n=2\\left((x-3)^2-9\\right)+3\n\\]\n\n\\[\n=2(x-3)^2-18+3\n\\]\n\n\\[\n=2(x-3)^2-15\n\\]"
        },
        {
          "title": "(b)",
          "body": "(b)\n\n\\[\ny=2(x+4)^2-12(x+4)+3\n\\]"
        },
        {
          "title": "Let",
          "body": "Let \\(u=x+4\\). From part (a),\n\n\\[\n2u^2-12u+3=2(u-3)^2-15\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So\n\n\\[\ny=2((x+4)-3)^2-15\n\\]\n\n\\[\ny=2(x+1)^2-15\n\\]"
        },
        {
          "title": "The minimum point is when",
          "body": "The minimum point is when \\(x=-1\\), giving \\(y=-15\\)."
        }
      ],
      "finalAnswer": "(a) \\(2(x-3)^2-15\\), (b) \\(M=(-1,-15)\\)"
    },
