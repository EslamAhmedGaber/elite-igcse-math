    "all::Jun2022_P1HR__Q25__p28-28__m05__Sequences": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:04:07",
      "topicNote": "Correct.",
      "steps": [
        {
          "title": "Calculate value",
          "body": "\\[\nS_{10}=4S_5\n\\]"
        },
        {
          "title": "Use",
          "body": "Use\n\n\\[\nS_n=\\frac n2(2a+(n-1)d)\n\\]\n\n\\[\nS_{10}=5(2a+9d)\n\\]\n\n\\[\nS_5=\\frac52(2a+4d)=5(a+2d)\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So\n\n\\[\n5(2a+9d)=4\\cdot 5(a+2d)\n\\]\n\n\\[\n2a+9d=4a+8d\n\\]\n\n\\[\nd=2a\n\\]"
        },
        {
          "title": "The 8th term is 45",
          "body": "The 8th term is 45:\n\n\\[\nu_8=a+7d=45\n\\]\n\n\\[\na+7(2a)=45\n\\]\n\n\\[\n15a=45\n\\]\n\n\\[\na=3\n\\]"
        }
      ],
      "finalAnswer": "The first term is \\(3\\)"
    },
    "all::Jun2022_P1HR__Q10__p11-11__m03__Linear-Graphs-y-mx-c": {
      "status": "checked",
