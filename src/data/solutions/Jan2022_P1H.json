    "all::Jan2022_P1H__Q19__p20-20__m05__Simultaneous-Equations": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:35:26",
      "topicNote": "Simultaneous equations. The tag is correct.",
      "steps": [
        {
          "title": "Solve simultaneous equations",
          "body": "\\[\n3x^2+y^2-xy=5\n\\]\n\n\\[\ny=2x-3\n\\]"
        },
        {
          "title": "Substitute",
          "body": "Substitute \\(y=2x-3\\):\n\\[\n3x^2+(2x-3)^2-x(2x-3)=5\n\\]\n\n\\[\n3x^2+4x^2-12x+9-2x^2+3x=5\n\\]\n\n\\[\n5x^2-9x+9=5\n\\]\n\n\\[\n5x^2-9x+4=0\n\\]"
        },
        {
          "title": "Factorise",
          "body": "Factorise:\n\\[\n(5x-4)(x-1)=0\n\\]"
        },
        {
          "title": "Solve simultaneous equations",
          "body": "So\n\\[\nx=\\frac45 \\quad \\text{or} \\quad x=1\n\\]"
        },
        {
          "title": "Solve simultaneous equations",
          "body": "If \\(x=\\frac45\\):\n\\[\ny=2\\left(\\frac45\\right)-3=-\\frac75\n\\]"
        },
        {
          "title": "Solve simultaneous equations",
          "body": "If \\(x=1\\):\n\\[\ny=2(1)-3=-1\n\\]"
        }
      ],
      "finalAnswer": "\\((x,y)=\\left(\\frac45,-\\frac75\\right)\\) or \\((1,-1)\\)."
    },
