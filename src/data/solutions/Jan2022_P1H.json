    "all::Jan2022_P1H__Q24__p27-27__m06__Differentiation": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:04:07",
      "topicNote": "Correct.",
      "steps": [
        {
          "title": "Calculate value",
          "body": "\\[\ny=ax^3+bx^2-12x+6\n\\]"
        },
        {
          "title": "Point lies on the curve",
          "body": "Point \\(A=(2,-6)\\) lies on the curve:\n\n\\[\n-6=8a+4b-24+6\n\\]\n\n\\[\n8a+4b=12\n\\]\n\n\\[\n2a+b=3\n\\]"
        },
        {
          "title": "Differentiate",
          "body": "Differentiate:\n\n\\[\n\\frac{dy}{dx}=3ax^2+2bx-12\n\\]"
        },
        {
          "title": "The gradient at is 16",
          "body": "The gradient at \\(x=2\\) is 16:\n\n\\[\n16=12a+4b-12\n\\]\n\n\\[\n12a+4b=28\n\\]\n\n\\[\n3a+b=7\n\\]"
        },
        {
          "title": "Solve",
          "body": "Now solve\n\n\\[\n2a+b=3\n\\]\n\n\\[\n3a+b=7\n\\]"
        },
        {
          "title": "Subtracting gives",
          "body": "Subtracting gives\n\n\\[\na=4\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "Then\n\n\\[\n2(4)+b=3\n\\]\n\n\\[\nb=-5\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "For \\(x=3\\),\n\n\\[\ny=4(3)^3-5(3)^2-12(3)+6\n\\]\n\n\\[\ny=108-45-36+6\n\\]\n\n\\[\ny=33\n\\]"
