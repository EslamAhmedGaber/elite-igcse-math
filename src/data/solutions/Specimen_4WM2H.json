      "steps": [
        {
          "title": "Calculate surface area",
          "body": "The curved surface area of a cone is\n\n\\[\n\\pi r l\n\\]"
        },
        {
          "title": "Calculate area",
          "body": "Here \\(r=20\\) and \\(\\pi r l=580\\pi\\), so\n\n\\[\n20l=580\n\\]\n\n\\[\nl=29\n\\]"
        },
        {
          "title": "Use Pythagoras to find the",
          "body": "Use Pythagoras to find the height of the cone:\n\n\\[\nh^2=29^2-20^2\n\\]\n\n\\[\nh^2=841-400=441\n\\]\n\n\\[\nh=21\n\\]"
        },
        {
          "title": "Volume of the cone",
          "body": "Volume of the cone:\n\n\\[\n\\frac13\\pi r^2h=\\frac13\\pi(20)^2(21)=2800\\pi\n\\]"
