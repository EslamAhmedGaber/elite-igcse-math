    "expertise::May2023_P1HR__Q24__p25-25__m05__Algebraic-Roots-and-Indices": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-05",
      "topicNote": "Correct.",
      "steps": [
        {
          "title": "Calculate value",
          "body": "\\[\n2^n=2^{x^2}\\times 16^x\\times 8\n\\]\n\n\\[\n16^x=(2^4)^x=2^{4x}\n\\]\n\n\\[\n8=2^3\n\\]"
        },
        {
          "title": "Calculate value",
          "body": "So\n\n\\[\n2^n=2^{x^2+4x+3}\n\\]\n\n\\[\nn=x^2+4x+3\n\\]"
        },
        {
          "title": "Complete the square",
          "body": "Complete the square:\n\n\\[\nn=(x+2)^2-1\n\\]\n\n\\[\n(x+2)^2=n+1\n\\]"
        },
        {
          "title": "Simplify surd",
          "body": "Since \\(x>0\\), take the positive root:\n\n\\[\nx+2=\\sqrt{n+1}\n\\]\n\n\\[\nx=\\sqrt{n+1}-2\n\\]"
        },
        {
          "title": "Simplify surd",
          "body": "For \\(x>0\\),\n\n\\[\n\\sqrt{n+1}>2\n\\]\n\n\\[\nn>3\n\\]"
        }
      ],
      "finalAnswer": "\\(x=\\sqrt{n+1}-2\\), with \\(n>3\\)"
    },
    "expertise::May2023_P1HR__Q23__p24-24__m04__Algebraic-Fractions": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-05",
      "topicNote": "Corrected from Surds to Algebraic Fractions.",
      "steps": [
        {
          "title": "Simplify surd",
          "body": "\\[\n(x^2-4)\\div \\left(\\frac{4x^2-7x-2}{x}\\right)-2x\n\\]"
        },
        {
          "title": "Change division into multiplication by",
          "body": "Change division into multiplication by the reciprocal:\n\n\\[\n(x^2-4)\\times \\frac{x}{4x^2-7x-2}-2x\n\\]"
        },
        {
          "title": "Factorise",
          "body": "Factorise:\n\n\\[\nx^2-4=(x-2)(x+2)\n\\]\n\n\\[\n4x^2-7x-2=(4x+1)(x-2)\n\\]"
        },
        {
          "title": "Simplify surd",
          "body": "So\n\n\\[\n\\frac{x(x-2)(x+2)}{(4x+1)(x-2)}-2x\n=\\frac{x(x+2)}{4x+1}-2x\n\\]\n\n\\[\n\\frac{x(x+2)-2x(4x+1)}{4x+1}\n=\\frac{x^2+2x-8x^2-2x}{4x+1}\n=\\frac{-7x^2}{4x+1}\n\\]"
        }
      ],
      "finalAnswer": "\\(\\dfrac{-7x^2}{4x+1}\\)"
    },
    "expertise::May2023_P1HR__Q20__p20-20__m07__Transformations-of-Graphs": {
