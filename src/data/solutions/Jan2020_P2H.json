    "all::Jan2020_P2H__Q24__p24-24__m04__Algebraic-Fractions": {
      "status": "checked",
      "checkedBy": "Dr Eslam Ahmed + Codex",
      "updated": "2026-05-06T07:04:07",
      "topicNote": "Corrected from Sine/Cosine Rule to Algebraic Fractions.",
      "steps": [
        {
          "title": "Use trigonometry",
          "body": "\\[\n\\left(\\frac4{2x-5}-\\frac3{2x-3}\\right)\\div\n\\frac{9x-4x^3}{6x^2-17x+5}\n\\]"
        },
        {
          "title": "Use trigonometry",
          "body": "First simplify the bracket:\n\n\\[\n\\frac4{2x-5}-\\frac3{2x-3}\n=\\frac{4(2x-3)-3(2x-5)}{(2x-5)(2x-3)}\n\\]\n\n\\[\n=\\frac{8x-12-6x+15}{(2x-5)(2x-3)}\n\\]\n\n\\[\n=\\frac{2x+3}{(2x-5)(2x-3)}\n\\]"
        },
        {
          "title": "Use trigonometry",
          "body": "Now factor the second fraction:\n\n\\[\n9x-4x^3=-x(2x-3)(2x+3)\n\\]\n\n\\[\n6x^2-17x+5=(2x-5)(3x-1)\n\\]"
        },
        {
          "title": "Dividing by a fraction means",
          "body": "Dividing by a fraction means multiplying by its reciprocal:\n\n\\[\n\\frac{2x+3}{(2x-5)(2x-3)}\n\\times\n\\frac{(2x-5)(3x-1)}{-x(2x-3)(2x+3)}\n\\]"
        },
        {
          "title": "Cancel common factors",
          "body": "Cancel common factors:\n\n\\[\n=-\\frac{3x-1}{x(2x-3)^2}\n\\]\n\n\\[\n=\\frac{1-3x}{x(2x-3)^2}\n\\]"
        }
      ],
      "finalAnswer": "\\(\\displaystyle \\boxed{\\frac{1-3x}{x(2x-3)^2}}\\)"
    },
